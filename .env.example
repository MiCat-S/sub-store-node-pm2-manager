# Sub-Store Node deployment example
# Official source baseline: sub-store-org/Sub-Store backend 2.38.0
# Do not add generic PORT/HOST/DATA_DIR variables. The Node backend reads the
# SUB_STORE_* variables below directly.

# Node backend listener. Official defaults: port 3000, host ::
SUB_STORE_BACKEND_API_PORT="3000"
SUB_STORE_BACKEND_API_HOST="127.0.0.1"

# Persistent JSON data. Official code default is the current working directory;
# use an absolute directory for a managed deployment.
SUB_STORE_DATA_BASE_PATH="/opt/sub-store/data"

# Official frontend dist directory and merged frontend/backend mode.
SUB_STORE_FRONTEND_PATH="/opt/sub-store/frontend"
SUB_STORE_BACKEND_MERGE="true"
SUB_STORE_FRONTEND_BACKEND_PATH="/replace-with-a-random-path"

# Official default: https://sub-store.vercel.app,http://substore.stash,https://substore.stash
# Self-hosted browser frontends should set their exact Origin without a path.
# SUB_STORE_CORS_ALLOWED_ORIGINS="https://sub-store.example.com"

# Optional separate-frontend mode. Do not set these in merged mode.
# SUB_STORE_FRONTEND_PORT="3001"
# SUB_STORE_FRONTEND_HOST="127.0.0.1"
# SUB_STORE_BACKEND_PREFIX="true"

# Optional request limits and proxy. Official defaults: 32768 and 1mb.
# SUB_STORE_MAX_HEADER_SIZE="32768"
# SUB_STORE_BODY_JSON_LIMIT="1mb"
# SUB_STORE_BACKEND_DEFAULT_PROXY="socks5://user:pass@127.0.0.1:7890"

# Optional push and scheduled jobs.
# SUB_STORE_PUSH_SERVICE="https://example.invalid/[推送标题]/[推送内容]"
# SUB_STORE_BACKEND_SYNC_CRON="55 23 * * *"
# SUB_STORE_BACKEND_DOWNLOAD_CRON="0 3 * * *"
# SUB_STORE_BACKEND_UPLOAD_CRON="0 4 * * *"
# SUB_STORE_PRODUCE_CRON="0 */2 * * *,sub,a;0 */3 * * *,col,b"

# Optional MaxMind databases and scheduled updates.
# SUB_STORE_MMDB_COUNTRY_PATH="/opt/sub-store/data/GeoLite2-Country.mmdb"
# SUB_STORE_MMDB_COUNTRY_URL="https://example.invalid/GeoLite2-Country.mmdb"
# SUB_STORE_MMDB_ASN_PATH="/opt/sub-store/data/GeoLite2-ASN.mmdb"
# SUB_STORE_MMDB_ASN_URL="https://example.invalid/GeoLite2-ASN.mmdb"
# SUB_STORE_MMDB_CRON="0 5 * * 1"

# Optional remote data restore. These values may contain credentials.
# SUB_STORE_DATA_URL="https://gist.githubusercontent.com/user/id/raw/Sub-Store#noCache"
# SUB_STORE_DATA_URL_POST="content.settings.gistToken='replace-me'"

# Optional frontend display and response header customization.
# SUB_STORE_BACKEND_CUSTOM_NAME="My Sub-Store"
# SUB_STORE_BACKEND_CUSTOM_ICON="https://example.invalid/icon.png"
# SUB_STORE_X_POWERED_BY="Sub-Store"

# Deprecated and intentionally omitted:
# SUB_STORE_BACKEND_CRON -> use SUB_STORE_BACKEND_SYNC_CRON
# SUB_STORE_CRON         -> use SUB_STORE_BACKEND_SYNC_CRON
# Docker HTTP-META variables HOST, PORT and META_* are not Node backend Env.
